mainmenu "nRF5340 crash-over-BLE lab"

source "Kconfig.zephyr"

menu "Crash lab"

config CRASH_LAB_VERSION
	string "Build identifier"
	default "lab-1"
	help
	  Human-readable identifier embedded in firmware and dump metadata.

config CRASH_LAB_AUTO_CRASH
	bool "Enable periodic random crashes"
	default n
	help
	  Keep disabled for first bring-up so BLE remains reachable.

config CRASH_LAB_AUTO_CRASH_SECONDS
	int "Seconds between automatic crashes"
	default 60
	range 10 3600
	depends on CRASH_LAB_AUTO_CRASH

config CRASH_LAB_STACK_SMASH
	bool "Enable optional stack-smash crash type"
	default n
	help
	  Adds crash type 4. Types 0..3 are always available.

config CRASH_LAB_UNSAFE_BLE_COMMANDS
	bool "Allow unauthenticated destructive BLE lab commands"
	default n
	help
	  Exposes intentional crash, reboot, evidence-clear, and synthetic event
	  commands through the custom GATT characteristic. This is only appropriate
	  for an isolated development bench. Leave disabled in derived firmware.

endmenu
